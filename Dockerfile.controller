# Dockerfile.controller - For the snake-controller service

FROM openjdk:25-jdk-slim

# Install essential runtime utilities if needed (e.g., curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy ONLY the Controller's JAR file
COPY backend-controller/target/snake-controller.jar controller.jar

# Environment Variables specific or defaulted for Controller
ENV WARN_AUDIT_FAILURE=true

# Volume for external configuration
VOLUME /app/config

# Expose the Controller's port
EXPOSE 8080

# Entrypoint to run the Controller JAR
ENTRYPOINT ["/usr/bin/tini", "--", "sh", "-c", "echo \"Starting controller...\" && \
    java -jar controller.jar \
    --server.port=8080 \
    --spring.config.additional-location=file:/app/config/application.yml \
    --cheese-auth.warn-audit-failure=${WARN_AUDIT_FAILURE} \
    "]
